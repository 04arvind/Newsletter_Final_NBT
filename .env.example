# Summarization (OpenAI — required for the आज का न्यूज़ रीकैप bullets).
# Without it the recap degrades to the scraped article description.
OPENAI_API_KEY=
# Defaults to gpt-5-nano.
# OPENAI_MODEL=
# Milliseconds to wait for the one batch recap request. Defaults to 30000.
# OPENAI_BATCH_TIMEOUT_MS=

# Persistence (Required - podcast analytics events + newsletter poll votes)
# MongoDB Atlas SRV connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_URI=
# Database name used by getDb(); defaults to "nbt_newsletter" when unset.
# MONGODB_DB=nbt_newsletter

# Email Delivery
# Resend is the TEMPORARY transport for local testing only — see
# src/lib/delivery/provider.ts for what replacing it involves.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
# Test inbox for delivery while no subscriber system exists. Used only when
# `subscribers` has no active rows; one address, or several separated by , or ;
NEWSLETTER_TO=
# Shared secret for the cron and delivery routes (x-cron-secret header).
# Unset means the delivery routes are open in development and refused in production.
CRON_SECRET=

#  Core App Config
NEXT_PUBLIC_APP_URL=
INTERNAL_BASE_URL=

# Trending Sources
GOOGLE_TRENDS_URL=
GOOGLE_TRENDS_MAX=
TWITTER_TRENDS_URL=
TWITTER_TRENDS_MAX=
TOP_N=

# Article Processing
MERGE_MAX_ARTICLES=

# LLM Intent Verification (Optional)
LLM_RERANK_ENABLED=
LLM_BASE_URL=
LLM_MODEL=
LLM_INTENT_MIN_SCORE=
NVIDIA_API_KEY=

# Persistence (Optional - for history tracking)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily Poll (question/options mirrored from navbharattimes.indiatimes.com;
# the vote split shown to readers is our own, stored in MongoDB)
#
# NBT's poll widget slot id. Resolution order, first match wins:
#   1. this env var (deploy-time pin)
#   2. the admin field in Mongo (poll_config), set via setAdminSectionId()
#   3. auto-detected from NBT's homepage
#   4. a built-in fallback id
# Leave blank to let auto-detect follow NBT's rotations on its own.
NBT_POLL_SECTION_ID=
# Seconds a fetched poll stays cached. Defaults to 600.
NBT_POLL_TTL=
